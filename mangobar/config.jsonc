{
    "layer": "top",
    "height": 15,
    "buffer-scale": 1,

    "modules-left": [
        "workspaces",
        "layout",
        "window"
    ],
    "modules-center": [],
    "modules-right": [
        "hideclients",
        "tray",
        "cpu",
        "memory",
        "pulseaudio",
        "clock#date",
        "clock#time",
        "custom/power"
    ],

    "workspaces": {
        "hide-empty": true,
        "pinned": [1, 2, 3, 4, 5],
        "overview-label": "OVERVIEW",
        "on-click": "activate",
        "on-click-right": "toggle"
    },
    "layout": {
        "format": "{}"
    },
    "window": {
        "format": "{}",
        "on-click": "bash ~/.config/mango/scripts/screenshot.sh",
        "on-click-right": "python /home/wrq/tool/ocr.py"
    },

    "network": {
        "format": "󰈀 {ifname}",
        "format-alt": "↓{down} ↑{up}"
    },
    "hideclients": {
        "format": " {}"
    },
    "cpu": {
        "format": " {load}%"
    },
    "memory": {
        "format": " {load}%"
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟"],
        "on-scroll-up": "bash ~/.config/mango/scripts/brightness.sh bup",
        "on-scroll-down": "bash ~/.config/mango/scripts/brightness.sh bdown",
        "on-click": "brightnessctl set 1%"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "icons": ["󰝟", "󰕿", "󰕾"],
        "on-click": "sh -c '/run/current-system/sw/bin/wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'",
        "on-scroll-up": "sh -c '/run/current-system/sw/bin/wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 2%+'",
        "on-scroll-down": "sh -c '/run/current-system/sw/bin/wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-'"
    },
    "battery": {
        "format": "{icon} {percent}% {ac}",
        "icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "clock#date": {
        "interval": 60,
        "format": " {:L%b%d·%A}"
    },
    "clock#time": {
        "interval": 1,
        "format": " {:L%I:%M%p}"
    },
    "tray": {
        "icon-size": 25,
        "spacing": 10
    },

    "custom/power": {
        "format": "",
        "on-click": "wlogout -C ~/.config/wlogout/style.css -l ~/.config/wlogout/layout -b 4 --protocol layer-shell",
        "on-click-right": "sleep 0.1s && swaync-client -t -sw"
    }
}
