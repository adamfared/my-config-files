configuration {
    modi: "drun,run,filebrowser,window";
    show-icons: false;
    font: "JetBrainsMono Nerd Font 11";
}

* {
    background-color: transparent;
    text-color:       #FCE8E8FF;
    margin:           0px;
    padding:          0px;
    border:           0px;
    spacing:          0px;
}

window {
    background-color: #000000D8;
    border:           4px;
    border-color:     #FF5C72FF;
    border-radius:    4px;
    width:            380px;
    height:           380px;
    padding:          16px;
}

listview {
    lines:            7;
    columns:          1;
    spacing:          6px;
    fixed-height:     true;
    border:           0px;
    margin:           0px;
    padding:          0px;
    scrollbar:        false;
}

scrollbar {
    width:            0px;
    border:           0px;
    handle-width:     0px;
    handle-color:     transparent;
    background-color: transparent;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    background-color: #141414FF;
    border-radius:    4px;
    padding:          8px 12px;
    children:         [ prompt, entry ];
}

prompt {
    padding:          0px 8px 0px 0px;
    text-color:       #FF5C72FF;
}

entry {
    placeholder:      "Search...";
    placeholder-color: #888888FF;
    text-color:       #FCE8E8FF;
}

/* --- THE FIX: Explicitly target normal, alternate, and selected states --- */

element,
element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active {
    background-color: transparent;
    text-color:       #FCE8E8FF;
    padding:          8px 12px;
    border-radius:    4px;
}

element-text,
element-text normal.normal,
element-text alternate.normal,
element-icon,
element-icon normal.normal,
element-icon alternate.normal {
    background-color: transparent;
    text-color:       #FCE8E8FF;
}

element selected.normal,
element selected.active {
    background-color: #FF5C72FF;
}

element-text selected.normal,
element-text selected.active,
element-icon selected.normal,
element-icon selected.active {
    background-color: transparent;
    text-color:       #1A1416FF;
}
