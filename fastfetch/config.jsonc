{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/nixos-logo-256.png",
    "width": 28,
    "preserveAspectRatio": true,
    "padding": {
      "top": 2,
      "left": 1,
      "right": 2
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "initsystem",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "font",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "localip",
    "locale",
    "break",
    "colors"
  ]
}
